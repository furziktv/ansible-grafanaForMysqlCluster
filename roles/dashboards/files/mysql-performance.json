      "targets": [
        {
          "expr": "100 * (1 - rate(mysql_global_status_innodb_buffer_pool_reads{server=~\"$server\"}[5m]) / clamp_min(rate(mysql_global_status_innodb_buffer_pool_read_requests{server=~\"$server\"}[5m]), 1))",
