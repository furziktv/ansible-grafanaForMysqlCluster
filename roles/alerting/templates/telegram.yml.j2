apiVersion: 1
contactPoints:
  - orgId: 1
    name: telegram
    receivers:
      - uid: mysql_cluster_telegram
        type: telegram
        settings:
          bottoken: {{ vault_telegram_bot_token | to_json }}
          chatid: {{ vault_telegram_chat_id | to_json }}
          parse_mode: 'None'
          message: |-
{% raw %}
            {{- range .Alerts.Firing -}}
            {{- if eq .Labels.alertname "DatasourceNoData" -}}
            ⚠️ Нет данных мониторинга{{ with .Labels.rulename }} · {{ . }}{{ end }}{{ printf "\n" }}
            {{- else if eq .Labels.alertname "DatasourceError" -}}
            🔴 Ошибка получения метрик{{ with .Labels.rulename }} · {{ . }}{{ end }}{{ printf "\n" }}
            {{- else -}}
            {{- if eq .Labels.severity "critical" }}🔴{{ else if eq .Labels.severity "warning" }}⚠️{{ else }}ℹ️{{ end }} {{ or .Annotations.summary .Labels.alertname }}{{ with .Labels.server }} · {{ . }}{{ end }}{{ with .Annotations.current_value }} · {{ . }}{{ end }}{{ with .Annotations.value_unit }}{{ . }}{{ end }}{{ printf "\n" }}
            {{- end -}}
            {{- end -}}
            {{- range .Alerts.Resolved -}}
            {{- if eq .Labels.alertname "DatasourceNoData" -}}
            ✅ Данные мониторинга восстановились{{ with .Labels.rulename }} · {{ . }}{{ end }}{{ printf "\n" }}
            {{- else if eq .Labels.alertname "DatasourceError" -}}
            ✅ Получение метрик восстановилось{{ with .Labels.rulename }} · {{ . }}{{ end }}{{ printf "\n" }}
            {{- else if eq .Labels.alertname "Replication Lag Warning" -}}
            ℹ️ Задержка репликации вышла из диапазона 15–60 с{{ with .Labels.server }} · {{ . }}{{ end }}{{ printf "\n" }}
            {{- else if eq .Labels.alertname "Disk Space Low" -}}
            ℹ️ Заполнение диска вышло из диапазона 80–90%{{ with .Labels.server }} · {{ . }}{{ end }}{{ printf "\n" }}
            {{- else if eq .Labels.severity "info" -}}
            ℹ️ {{ or .Annotations.resolved .Annotations.summary .Labels.alertname }}{{ with .Labels.server }} · {{ . }}{{ end }}{{ printf "\n" }}
            {{- else -}}
            ✅ {{ or .Annotations.resolved .Annotations.summary .Labels.alertname }}{{ with .Labels.server }} · {{ . }}{{ end }}{{ printf "\n" }}
            {{- end -}}
            {{- end -}}
            {{- if and (eq (len .Alerts.Firing) 0) (eq (len .Alerts.Resolved) 0) -}}
            ℹ️ Тест уведомления{{ printf "\n" }}
            {{- end -}}
{% endraw %}
policies:
  - orgId: 1
    receiver: telegram
    # '...' не объединяет разные alert instances: один показатель = одно сообщение.
    group_by: ['...']
    group_wait: 0s
    group_interval: 5s
    repeat_interval: 4h
    routes:
      - receiver: telegram
        object_matchers:
          - [alertname, '=', DatasourceNoData]
        group_by: [alertname]
        group_wait: 2m
        group_interval: 30m
        repeat_interval: 12h
      - receiver: telegram
        object_matchers:
          - [alertname, '=', DatasourceError]
        group_by: [alertname]
        group_wait: 2m
        group_interval: 30m
        repeat_interval: 12h
