            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "expression": "$A > 90",
                "type": "math",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            }
          ]
        },
        {
          "uid": "disk_low",
          "title": "Disk Space Low",
          "condition": "B",
          "for": "5s",
          "noDataState": "NoData",
          "execErrState": "Error",
          "annotations": {
            "summary": "Диск / заполнен более чем на 80%",
            "description": "Проверить метрики и состояние кластера. Мониторинг не управляет failover.",
            "value_unit": "%",
            "current_value": "{{ printf \"%.1f\" $values.A.Value }}",
            "resolved": "На диске снова достаточно места"
          },
          "labels": {
