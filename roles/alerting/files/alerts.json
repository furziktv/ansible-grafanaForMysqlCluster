              "model": {
                "refId": "A",
                "expr": "(mysql_slave_status_seconds_behind_master or mysql_slave_status_seconds_behind_source)",
                "instant": true,
                "range": false,
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "intervalMs": 1000,
                "maxDataPoints": 43200
