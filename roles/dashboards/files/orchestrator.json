{
  "uid": "orchestrator",
  "title": "Orchestrator",
  "description": "API, топология, проблемы и история восстановления.",
  "tags": [
    "mysql",
    "replication",
    "monitoring"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 2,
  "refresh": "10s",
