    {
      "id": 2,
      "title": "Текущий Primary",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "((mysql_global_variables_read_only{server=~\"db[123]\"} == 0) and on(server) (mysql_up{server=~\"db[123]\"} == 1) and on(server) (up{job=\"mysql\",server=~\"db[123]\"} == 1)) and on() (count((mysql_global_variables_read_only{server=~\"db[123]\"} == 0) and on(server) (mysql_up{server=~\"db[123]\"} == 1) and on(server) (up{job=\"mysql\",server=~\"db[123]\"} == 1)) == 1)",
          "refId": "A",
          "legendFormat": "{{server}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "НЕТ ДАННЫХ",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "description": "Единственный доступный для записи MySQL. При неоднозначности показывается НЕТ ДАННЫХ.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
