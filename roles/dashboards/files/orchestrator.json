    "from": "now-6h",
    "to": "now"
  },
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "01  /  API И РОЛЬ КЛАСТЕРА",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "title": "Текущий Primary",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "((mysql_global_variables_read_only{server=~\"db[123]\"} == 0) and on(server) (mysql_up{server=~\"db[123]\"} == 1) and on(server) (up{job=\"mysql\",server=~\"db[123]\"} == 1)) and on() (count((mysql_global_variables_read_only{server=~\"db[123]\"} == 0) and on(server) (mysql_up{server=~\"db[123]\"} == 1) and on(server) (up{job=\"mysql\",server=~\"db[123]\"} == 1)) == 1)",
          "refId": "A",
          "legendFormat": "{{server}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "НЕТ ДАННЫХ",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "API доступны",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(orchestrator_api_up)",
          "refId": "A",
          "legendFormat": "{{server}}",
          "instant": true,
          "range": false
