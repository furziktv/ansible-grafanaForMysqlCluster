              },
              "model": {
                "refId": "A",
                "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",server=~\"db[123]\"} / node_filesystem_size_bytes{mountpoint=\"/\",server=~\"db[123]\"})",
                "instant": true,
