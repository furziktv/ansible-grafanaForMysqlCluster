            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "expression": "$A > 15 && $A <= 60",
                "type": "math",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            }
          ]
        },
        {
          "uid": "cpu_high",
          "title": "CPU High",
          "condition": "B",
          "for": "5s",
          "noDataState": "NoData",
          "execErrState": "Error",
          "annotations": {
            "summary": "Загрузка CPU выше 85%",
            "description": "Проверить метрики и состояние кластера. Мониторинг не управляет failover.",
            "value_unit": "%",
            "current_value": "{{ printf \"%.1f\" $values.A.Value }}",
            "resolved": "Загрузка CPU снизилась"
          },
          "labels": {
            "severity": "warning",
