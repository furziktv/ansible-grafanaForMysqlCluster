                "refId": "B",
                "expression": "$A > 0",
                "type": "math",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            }
          ]
        },
        {
          "uid": "failover_detected",
          "title": "Failover Detected",
          "condition": "B",
          "for": "5s",
          "noDataState": "NoData",
          "execErrState": "Error",
          "annotations": {
            "summary": "Обнаружено переключение Primary",
            "description": "Проверить метрики и состояние кластера. Мониторинг не управляет failover.",
            "resolved": "Истекло 5-минутное окно после failover"
          },
          "labels": {
            "severity": "info",
            "service": "mysql-cluster"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "((time() - orchestrator_last_failover_timestamp_seconds) < bool 300) * (orchestrator_last_failover_timestamp_seconds > bool 0)",
                "instant": true,
                "range": false,
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
