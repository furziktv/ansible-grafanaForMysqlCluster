{
  "uid": "mysql-performance",
  "title": "MySQL Performance",
  "description": "Нагрузка и внутренние метрики MySQL.",
  "tags": [
    "mysql",
    "replication",
    "monitoring"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "01  /  НАГРУЗКА",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "title": "QPS · всего",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(rate(mysql_global_status_queries{server=~\"$server\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{server}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "НЕТ ДАННЫХ",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area"
      }
    },
