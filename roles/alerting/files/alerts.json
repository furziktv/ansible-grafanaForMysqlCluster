        {
          "uid": "primary_changed",
          "title": "Primary Changed",
          "condition": "B",
          "for": "5s",
          "noDataState": "NoData",
          "execErrState": "Error",
          "annotations": {
            "summary": "Primary сменился",
            "description": "Проверить метрики и состояние кластера. Мониторинг не управляет failover.",
            "resolved": "Истекло 5-минутное окно отслеживания смены Primary"
          },
          "labels": {
            "severity": "info",
            "service": "mysql-cluster"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "increase(orchestrator_primary_changes_total[5m])",
                "instant": true,
                "range": false,
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
